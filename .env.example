# 在【运行后端的服务器】上复制为 .env 并填写，不要提交 .env 到 Git
# 用户打开网页时不会接触这些密钥，全部由后端访问

# 阿里云 DashScope（Qwen3-Omni 等），二选一即可
CHAT_API_KEY=sk-你的API密钥
# 或使用与官方示例一致的环境变量名：
# DASHSCOPE_API_KEY=sk-你的API密钥

# 可选：接口地址与模型（有默认值）
# CHAT_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# CHAT_MODEL=qwen3-omni-flash-2025-12-01

# 数据库（若使用）
# MYSQL_HOST=...
# MYSQL_PASSWORD=...
